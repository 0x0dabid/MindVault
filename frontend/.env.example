# ── Required ─────────────────────────────────────────────────────────────────
# Deployed address of MindVaultRouter.sol on Ritual Chain (Chain ID 1979)
NEXT_PUBLIC_ROUTER_ADDRESS=0x

# Deployed address of MindVaultFactory.sol (enables per-user harness deployment)
NEXT_PUBLIC_FACTORY_ADDRESS=0x

# WalletConnect project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the public Ritual RPC (useful if you're hitting rate limits)
NEXT_PUBLIC_RPC_URL=https://rpc.ritualfoundation.org

# HuggingFace token for conversation history DA storage
# If set, chat history is persisted per-session to your HF dataset
HF_TOKEN=
HF_REPO_ID=          # format: your-org/your-dataset (must be private)
